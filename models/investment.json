          "minRedemptionAmount": 5000.00,
          "penaltyRate": 0
        },
        {
          "windowNumber": 3,
          "availableDate": "2027-08-13",
          "minRedemptionAmount": 0,
          "penaltyRate": 0
        }
      ],
      "earlyRedemptionAllowed": false,
      "earlyRedemptionPenalty": 0
    },
    "performance": {
      "currentBalance": 85000.00,
      "accumulatedReturn": 0,
      "returnRate": 0,
      "lastUpdateDate": "2026-02-13",
      "projectedFinalBalance": 100500.00,
      "projectedTotalReturn": 15500.00
    },
    "taxation": {
      "taxType": "ir_regressivo",
      "currentTaxRate": 22.5,
      "estimatedTax": 2325.00,
      "netReturn": 13175.00
    },
    "protection": {
