    },
    "liquidityRules": {
      "liquidityType": "semestral",
      "liquidityWindows": [
        {
          "windowNumber": 1,
          "availableDate": "2026-08-13",
          "minRedemptionAmount": 5000.00,
          "penaltyRate": 0
        },
        {
          "windowNumber": 2,
